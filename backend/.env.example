# Copia este archivo a backend/.env y rellena la clave. backend/.env NO se sube a git.
# Todos los valores (salvo la clave) tienen un valor por defecto en app/core/config.py;
# aquí están los que tiene sentido ajustar.

DATABASE_URL=postgresql+psycopg://bet_user:bet_pass@localhost:5432/bet_db
API_FOOTBALL_KEY=your_api_football_key_here

# Casas donde apuestas, separadas por comas (vacío = todas). El EV de un pick solo
# existe en la casa que da esa cuota. Ej.: Betano,Bwin
ALLOWED_BOOKMAKERS=

# Rango de cuota de los picks.
ODDS_MIN=1.50
ODDS_MAX=2.00

# Filtro de picks: EV mínimo, techo de EV creíble (por encima suele ser error del
# modelo), habilidad mínima demostrada en backtest (accuracy - tasa base).
MIN_PICK_EV=0.02
MAX_PLAUSIBLE_EV=0.20
MIN_HISTORICAL_SKILL=0.0

# Datos mínimos: partidos de historial por equipo y antigüedad máxima de las cuotas.
MIN_TEAM_HISTORY_MATCHES=10
MAX_ODDS_AGE_HOURS=6.0

# Kelly fraccional (1/4 Kelly) para la sugerencia de stake.
KELLY_FRACTION_CAP=0.25

# Actualización automática del día: la primera vez que abres la página cada
# mañana, desde esta hora (hora de Colombia). La cuota de la API se renueva a
# las 19:00 y eso no se puede cambiar; esto decide cuándo se gasta.
AUTO_UPDATE_HOUR=6

# Picks por día: Europa y el apartado de fútbol colombiano (contadores separados).
TOP_PICKS_COUNT=5
COLOMBIA_TOP_PICKS_COUNT=3

# Versiones de modelo (separan picks, evaluaciones y validaciones).
MODEL_VERSION=v1
COLOMBIA_MODEL_VERSION=col-v1
